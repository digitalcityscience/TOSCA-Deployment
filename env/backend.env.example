# Runtime configuration; replace placeholders on the server. Never commit .env.prod.
PG_DATABASE=tosca
PG_SUPERUSER=postgres
PG_SUPERPASS=replace-me
PG_API_USER=tosca_api
PG_API_PASSWORD=replace-me
PG_GS_USER=tosca_geoserver
PG_GS_PASSWORD=replace-me
PG_SCHEMA_API=public
PG_SCHEMA_GEOSERVER=geoserver
PG_SCHEMA_GIS=gis
PG_SCHEMA_JDBCCONF=jdbconfig
DJANGO_SECRET_KEY=replace-me
FIELD_ENCRYPTION_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tosca.example.org
DJANGO_CORS_ALLOWED_ORIGINS=https://tosca.example.org
KEYCLOAK_SERVER_URL=https://keycloak.example.org
KEYCLOAK_REALM=replace-me
KEYCLOAK_CLIENT_ID=replace-me
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_JWKS_URL=https://keycloak.example.org/realms/replace-me/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://keycloak.example.org/realms/replace-me
ALLOWED_TOKEN_AUDIENCES=replace-me
ALLOWED_TOKEN_CLIENTS=replace-me
GEOSERVER_VERSION=replace-me
GEOSERVER_HOST=geoserver
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-me
